{
  "name": "Fileway Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [5000, 5001, 5229],
  "portsAttributes": {
    "5000": { "label": "Fileway API", "onAutoForward": "notify" },
    "5001": { "label": "Fileway Client", "onAutoForward": "openBrowser" },
    "5229": { "label": ".NET Hot Reload", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.blazorwasm-companion",
        "editorconfig.editorconfig",
        "ms-azuretools.vscode-docker",
        "github.vscode-pull-request-github",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.trimTrailingWhitespace": true,
        "dotnet.defaultSolution": "Fileway.sln"
      }
    }
  }
}
