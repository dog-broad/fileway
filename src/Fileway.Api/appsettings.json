{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Api": {
    "MaxConcurrentJobs": 10,
    "MaxJobsPerSession": 3,
    "MaxOnnxJobs": 2,
    "MaxQueueDepth": 50,
    "DefaultTimeoutSeconds": 60,
    "JobSweepIntervalMinutes": 5,
    "CompletedJobRetentionMinutes": 10,
    "MaxRequestSizeBytes": 209715200,
    "IpHashSalt": "change-in-production"
  },
  "RateLimit": {
    "SessionTokenWindowSeconds": 60,
    "SessionTokenFreePermitLimit": 20,
    "SessionTokenPaidPermitLimit": 100,
    "IpHashWindowSeconds": 60,
    "IpHashPermitLimit": 60
  },
  "LibreOffice": {
    "ExecutablePath": "soffice",
    "MaxConcurrent": 2,
    "TempBasePath": "/tmp/fileway/"
  },
  "Storage": {
    "UseLocalStorage": true,
    "LocalStoragePath": "/tmp/fileway/output/",
    "BucketName": "",
    "AccountId": "",
    "SignedUrlTtlMinutes": 30
  }
}
