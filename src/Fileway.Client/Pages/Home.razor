@page "/"

<PageTitle>Fileway — Any file. Any format. One way.</PageTitle>

<div class="home-page">
    <section class="hero">
        <h1 class="hero-tagline">Any file. Any format.<br />One way.</h1>
        <p class="hero-subtitle">Convert, validate, and transform files instantly in your browser. Private. No sign-up.</p>
        <form class="hero-search" method="get" action="/tools">
            <input type="search" name="q" class="hero-search-input"
                   placeholder="Search tools…" aria-label="Search tools" />
            <button type="submit" class="hero-search-btn" aria-label="Search">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
            </button>
        </form>
    </section>

    <section class="categories" aria-label="Tool categories">
        <h2 class="categories-title">Browse by category</h2>
        <div class="category-grid">
            <a href="/tools?category=Data" class="category-card">
                <span class="category-icon" aria-hidden="true">{ }</span>
                <div class="category-info">
                    <span class="category-name">Data</span>
                    <span class="category-desc">JSON, YAML, CSV, TOML converters and validators</span>
                </div>
            </a>
        </div>
    </section>
</div>
