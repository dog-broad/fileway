@using Fileway.Shared.Formats

@switch (PreviewKind)
{
    case PreviewKind.SyntaxHighlight:
        <SyntaxHighlightPreview Content="@Content" Format="@Format" />
        break;
    case PreviewKind.SideBySideImage:
        <SideBySideImagePreview
            BeforeBytes="@BeforeBytes"
            AfterBytes="@AfterBytes"
            BeforeMimeType="@BeforeMimeType"
            OutputMimeType="@OutputMimeType" />
        break;
    case PreviewKind.InlineEditor:
        @* InlineEditor is rendered by the tool page directly — not via PreviewPanel *@
        break;
    case PreviewKind.None:
    default:
        break;
}

@code {
    [Parameter] public PreviewKind PreviewKind { get; set; }

    // Text preview parameters (SyntaxHighlight)
    [Parameter] public string? Content { get; set; }
    [Parameter] public FileFormat? Format { get; set; }

    // Image preview parameters (SideBySideImage)
    [Parameter] public byte[]? BeforeBytes { get; set; }
    [Parameter] public byte[]? AfterBytes { get; set; }
    [Parameter] public string? BeforeMimeType { get; set; }
    [Parameter] public string? OutputMimeType { get; set; }
}
