<div class="dimension-inputs">
    <div class="dimension-row">
        <div class="dimension-field">
            <label class="dimension-label" for="dim-width">Width</label>
            <div class="dimension-input-wrap">
                <input id="dim-width"
                       type="number"
                       class="dimension-input"
                       min="1"
                       max="99999"
                       placeholder="px"
                       value="@Width"
                       @onchange="HandleWidthChanged"
                       aria-label="Width in pixels" />
                <span class="dimension-unit" aria-hidden="true">px</span>
            </div>
        </div>

        <button class="dimension-lock-btn"
                type="button"
                @onclick="ToggleLock"
                title="@(LockAspectRatio ? "Unlock aspect ratio" : "Lock aspect ratio")"
                aria-label="@(LockAspectRatio ? "Unlock aspect ratio" : "Lock aspect ratio")"
                aria-pressed="@LockAspectRatio.ToString().ToLowerInvariant()">
            @if (LockAspectRatio)
            {
                @* Lock icon — closed padlock *@
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            }
            else
            {
                @* Unlock icon — open padlock *@
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 9.9-1"/>
                </svg>
            }
        </button>

        <div class="dimension-field">
            <label class="dimension-label" for="dim-height">Height</label>
            <div class="dimension-input-wrap">
                <input id="dim-height"
                       type="number"
                       class="dimension-input"
                       min="1"
                       max="99999"
                       placeholder="px"
                       value="@Height"
                       @onchange="HandleHeightChanged"
                       aria-label="Height in pixels" />
                <span class="dimension-unit" aria-hidden="true">px</span>
            </div>
        </div>
    </div>

    @if (OriginalWidth.HasValue && OriginalHeight.HasValue)
    {
        <p class="dimension-original">
            Original: @OriginalWidth×@OriginalHeight px
        </p>
    }
</div>

@code {
    [Parameter] public int? Width { get; set; }
    [Parameter] public EventCallback<int?> WidthChanged { get; set; }
    [Parameter] public int? Height { get; set; }
    [Parameter] public EventCallback<int?> HeightChanged { get; set; }
    [Parameter] public bool LockAspectRatio { get; set; } = true;
    [Parameter] public EventCallback<bool> LockAspectRatioChanged { get; set; }
    [Parameter] public int? OriginalWidth { get; set; }
    [Parameter] public int? OriginalHeight { get; set; }

    private async Task HandleWidthChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var w) || w < 1)
        {
            await WidthChanged.InvokeAsync(null);
            return;
        }
        await WidthChanged.InvokeAsync(w);

        if (LockAspectRatio && Height.HasValue && Width.HasValue && Width.Value > 0)
        {
            var ratio = (double)Height.Value / Width.Value;
            var newHeight = (int)Math.Round(w * ratio);
            await HeightChanged.InvokeAsync(newHeight > 0 ? newHeight : 1);
        }
        else if (LockAspectRatio && OriginalWidth.HasValue && OriginalHeight.HasValue && OriginalWidth.Value > 0)
        {
            var ratio = (double)OriginalHeight.Value / OriginalWidth.Value;
            var newHeight = (int)Math.Round(w * ratio);
            await HeightChanged.InvokeAsync(newHeight > 0 ? newHeight : 1);
        }
    }

    private async Task HandleHeightChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var h) || h < 1)
        {
            await HeightChanged.InvokeAsync(null);
            return;
        }
        await HeightChanged.InvokeAsync(h);

        if (LockAspectRatio && Width.HasValue && Height.HasValue && Height.Value > 0)
        {
            var ratio = (double)Width.Value / Height.Value;
            var newWidth = (int)Math.Round(h * ratio);
            await WidthChanged.InvokeAsync(newWidth > 0 ? newWidth : 1);
        }
        else if (LockAspectRatio && OriginalWidth.HasValue && OriginalHeight.HasValue && OriginalHeight.Value > 0)
        {
            var ratio = (double)OriginalWidth.Value / OriginalHeight.Value;
            var newWidth = (int)Math.Round(h * ratio);
            await WidthChanged.InvokeAsync(newWidth > 0 ? newWidth : 1);
        }
    }

    private async Task ToggleLock()
    {
        await LockAspectRatioChanged.InvokeAsync(!LockAspectRatio);
    }
}
