@using Fileway.Shared.Formats

<span class="format-badge format-badge--@_sizeName" style="@_style" title="@Format.DisplayName">
    <FormatIcon FormatId="@Format.Id" Width="@_iconSize" />
    <span class="format-badge-label">@Format.DisplayName</span>
</span>

@code {
    [Parameter, EditorRequired] public FileFormat Format { get; set; } = null!;
    [Parameter] public BadgeSize Size { get; set; } = BadgeSize.Md;

    private string _sizeName => Size switch
    {
        BadgeSize.Sm => "sm",
        BadgeSize.Lg => "lg",
        _ => "md"
    };

    private int _iconSize => Size switch
    {
        BadgeSize.Sm => 12,
        BadgeSize.Lg => 18,
        _ => 14
    };

    private string _style =>
        $"--badge-bg: var(--format-{Format.Id}-bg, color-mix(in srgb, var(--color-accent) 12%, transparent)); " +
        $"--badge-fg: var(--format-{Format.Id}-fg, var(--color-accent))";
}
